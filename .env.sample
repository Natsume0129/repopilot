# See https://docs.karakeep.app/configuration for more information
DATA_DIR=<path>
NEXTAUTH_SECRET=<secret>

# RepoPilot: deterministic offline demo by default; explicit live opt-in.
REPOPILOT_MODE=mock
GITHUB_TOKEN=
REPOPILOT_LLM_API_KEY=
REPOPILOT_LLM_BASE_URL=
REPOPILOT_LLM_MODEL=
REPOPILOT_MAX_GITHUB_CALLS=24
REPOPILOT_MAX_LLM_CALLS=5
REPOPILOT_MAX_RUN_SECONDS=180
