# Non-secret example. Prefer `node scripts/repopilot-setup.mjs` for local setup.
DATA_DIR=/absolute/path/to/repopilot/data
NEXTAUTH_SECRET=replace-with-a-random-local-secret
NEXTAUTH_URL=http://localhost:3000
REPOPILOT_MODE=mock
GITHUB_TOKEN=
REPOPILOT_LLM_API_KEY=
# User-approved HTTPS OpenAI-compatible base URL, normally ending in /v1
REPOPILOT_LLM_BASE_URL=
REPOPILOT_LLM_MODEL=
REPOPILOT_MAX_GITHUB_CALLS=24
REPOPILOT_MAX_LLM_CALLS=5
REPOPILOT_MAX_RUN_SECONDS=180
